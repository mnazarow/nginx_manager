# Ротация журналов nginx, используемых Nginx Manager для статистики.
# Сервис отслеживает ротацию сам (по смене inode) и дочитывает старый файл.
/var/log/nginx/nm-*.log {
    daily
    rotate 14
    maxsize 500M
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    create 0640 root adm
    postrotate
        [ -s /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)" 2>/dev/null || true
    endscript
}
