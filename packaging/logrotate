# Ротация журналов nginx, используемых Nginx Manager для статистики.
# Сервис отслеживает ротацию сам (по смене inode) и дочитывает старый файл.
/var/log/nginx/nm-*.log {
    daily
    rotate 14
    maxsize 500M
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    create 0640 root adm
    postrotate
        [ -s /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)" 2>/dev/null || true
        # журнал аудита ModSecurity nginx по USR1 не переоткрывает — плавная перезагрузка (HUP) открывает новый файл
        [ -e /var/log/nginx/nm-modsec-audit.log ] && [ -s /run/nginx.pid ] && \
            kill -HUP "$(cat /run/nginx.pid)" 2>/dev/null || true
    endscript
}
