[Unit]
Description=Nginx Manager — панель управления nginx (конфигурация, статистика, диагностика)
Documentation=file:///opt/nginx-manager/docs/README.md
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/nginx-manager/panel.conf
WorkingDirectory=/opt/nginx-manager
ExecStart=/opt/nginx-manager/venv/bin/python -m app.main
Restart=always
RestartSec=3
TimeoutStopSec=20
# Сервису нужны права root: запись /etc/nginx, nginx -t/reload, certbot, чтение журналов nginx.
User=root
LimitNOFILE=65535
# Ограничения, не мешающие работе (см. docs/11-security.md)
PrivateTmp=true
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
UMask=0022

[Install]
WantedBy=multi-user.target
